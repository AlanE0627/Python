     #Miscellaneous Configuration
     TIMEZONE: GMT
-    CHARSET: US-ASCII                          # Is loaded first, so applies to the rest of this config. Defaults to US-ASCII if invalid or not set.
+    CHARSET: UTF-8                             # Is loaded first, so applies to the rest of this config. Defaults to US-ASCII if invalid or not set.
